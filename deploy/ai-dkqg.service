# Ubuntu 22.04：systemd 服务。把 /opt/ai-dkqg 和 User 改成你的实际路径和账号，然后：
#   sudo cp deploy/ai-dkqg.service /etc/systemd/system/
#   sudo systemctl daemon-reload && sudo systemctl enable --now ai-dkqg
#   journalctl -u ai-dkqg -f        # 看日志（插件口令也在里面）
[Unit]
Description=AI 多方会议中转站
After=network.target

[Service]
Type=simple
User=sara
WorkingDirectory=/opt/ai-dkqg
Environment=PORT=8765
Environment=DATA_DIR=/opt/ai-dkqg/data
ExecStart=/usr/bin/node backend/dist/server.mjs
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
